# Fichier de configuration pour la formation LangChain + Mistral AI
# Copiez ce fichier en .env et renseignez vos clés API

# Clé API Mistral AI — OBLIGATOIRE
# Obtenez votre clé sur : https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Optionnel : Pour la traçabilité et l'évaluation avec LangSmith
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=lc-essentials-mistral