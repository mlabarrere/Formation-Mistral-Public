# Copiez ce fichier vers .env puis remplacez uniquement les valeurs d'exemple.
# Ne partagez et ne versionnez jamais votre fichier .env.

# Obligatoire : accès au serveur Mistral utilisé pendant la formation.
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_SERVER_URL=your_mistral_server_url_here

# Traçabilité LangSmith (recommandée) — créez un compte gratuit sur
# https://smith.langchain.com/ puis générez une API key.
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=formation-mistral-j2
